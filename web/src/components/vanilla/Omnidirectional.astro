---
const ROWS = 4
const COLS = 4
const { class: className, ...rest } = Astro.props
const cols = Array.from({ length: COLS }, (_, i) => i)

const size = 16
const rowSize = size * (5 / 3)
---

<div data-example="omnidirectional" class="relative">
  <div
    {...rest}
    style={`
      --slide-size:${size}rem;
      --row-size:${rowSize}rem;
      padding-left: calc(50% - var(--row-size)/2);
      padding-top: calc(40svh - var(--slide-size)/2);
    `}
    tabindex="0"
    data-slider
    class:list={[
      "mx-auto flex h-[80svh] w-[min(80svw,60rem)] shrink-0 flex-col overflow-hidden outline outline-gray-700/80",
      className,
      "focus:outline-gray-700/80",
    ]}
  >
    {
      Array.from({ length: ROWS }, (_, r) => (
        <div class="flex h-[var(--slide-size)] shrink-0 outline outline-gray-700/40">
          {cols.map((_, c) => (
            <div class="flex aspect-[5/3] h-[var(--slide-size)] shrink-0 items-center justify-center">
              <div class="relative flex h-full w-full items-center justify-center p-6 outline outline-gray-600 transition-transform">
                <p class="mono text-md text-gray-200">
                  {r + 1}.{c + 1}
                </p>
                <div
                  data-parallax
                  class="pointer-events-none absolute inset-3 flex items-center justify-center outline outline-dashed outline-gray-400/60"
                >
                  <p class="mono text-[10px] text-gray-400/70">parallax</p>
                </div>
              </div>
            </div>
          ))}
        </div>
      ))
    }
  </div>
</div>

<script>
  import { Slider } from "~/wip/slider/omnidirectional"

  const root = document.querySelector(
    "[data-example='omnidirectional'] [data-slider]"
  ) as HTMLElement | null

  if (root) {
    new Slider(root, {
      infinite: true,
      snap: true,
      parallax: 20,
    })
  }
</script>
