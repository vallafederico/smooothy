---
interface Props {
  marketId: number
  theme?: "dark" | "light"
  type?: "compact" | "full"
  width?: string
  height?: string
}

const {
  marketId,
  theme = "dark",
  type = "compact",
  width = "420",
  height = "315"
} = Astro.props

const embedUrl = `https://embed.precog.market/market?network=8453&id=${marketId}&type=${type}&theme=${theme}&source=chain`
---

<div class="market-embed overflow-hidden rounded-lg">
  <iframe
    src={embedUrl}
    width={width}
    height={height}
    frameborder="0"
    allow="clipboard-write"
    loading="lazy"
    class="block"
  ></iframe>
</div>

<style>
  .market-embed {
    background: rgba(255, 255, 255, 0.02);
  }
</style>
